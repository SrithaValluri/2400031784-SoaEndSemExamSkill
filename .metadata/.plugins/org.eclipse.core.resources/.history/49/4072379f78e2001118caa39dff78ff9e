
openapi: 3.0.0

info:
  title: MS1 Addition API
  description: API to add two numbers
  version: 1.0.0

servers:
  - url: http://localhost:8001

paths:
  /ms1/add:
    get:
      summary: Add two numbers

      parameters:
        - name: a
          in: query
          required: true
          schema:
            type: integer
          example: 10

        - name: b
          in: query
          required: true
          schema:
            type: integer
          example: 20

      responses:
        '200':
          description: Addition successful
          content:
            application/json:
              schema:
                type: object
                properties:
                  message:
                    type: string
                    example: addition
                  result:
                    type: integer
                    example: 30

        '400':
          description: Invalid request
